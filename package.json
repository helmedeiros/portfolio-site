{
  "name": "ossified-osiris",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pre-push": "npm run test:run && npm run build",
    "demo": "npm run build && node docs/demo/record.mjs",
    "ci-check": "npm run test:run && npm run build && npm run preview -- --host 127.0.0.1 --port 4321",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^5.10.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@vitest/ui": "^5.1.0",
    "jsdom": "^31.0.0",
    "playwright": "1.49.1",
    "vitest": "^5.1.0"
  }
}
